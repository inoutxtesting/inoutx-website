# Public EmailJS configuration (Vite embeds these values in browser assets).
# Only the EmailJS public key belongs here. Never use a private key or password.
VITE_EMAILJS_SERVICE_ID=your_service_id
VITE_EMAILJS_TEMPLATE_ID=your_template_id
VITE_EMAILJS_PUBLIC_KEY=your_public_key

# Optional: Flask backend port when running app.py (default: 5000).
PORT=5000
