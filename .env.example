# ========================================================
# INOUTX Website - Environment Configuration
# ========================================================
# Copy this file to .env and fill in your actual credentials.
#
# IMPORTANT:
# For Gmail, you MUST use a 16-character App Password, NOT your regular Google password.
# How to generate a Gmail App Password:
# 1. Enable 2-Step Verification in your Google Account: https://myaccount.google.com/security
# 2. Go to "App Passwords": https://myaccount.google.com/apppasswords
# 3. Create an app named "INOUTX Portal"
# 4. Copy the generated 16-character password into SMTP_PASSWORD below.
# ========================================================

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_EMAIL=your_verified_sender@gmail.com
SMTP_PASSWORD=your_gmail_app_password
CONTACT_RECEIVER_EMAIL=inoutx.testing@gmail.com

# Backend Server Port (Default: 5000)
PORT=5000
